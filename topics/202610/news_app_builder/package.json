{
  "name": "news-app-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json"
  },
  "dependencies": {
    "@databricks/appkit": "0.76.1",
    "@databricks/appkit-ui": "0.76.1",
    "lucide-react": "0.546.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7",
    "fast-uri": "3.1.0",
    "socks": "2.8.7",
    "bare-path": "3.1.1",
    "bare-url": "2.5.2"
  }
}
